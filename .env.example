# ==============================================================================
# VeganForm AI - Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PRIVATE SERVER-SIDE SECRETS (Keep secret - NEVER expose in frontend/git)
# ------------------------------------------------------------------------------

# Gemini API Key (Required for AI-powered formulation synthesis)
# Obtained from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY="your_gemini_api_key_here"

# Runtime Environment mode
# Set to 'production' on live cloud deployments
NODE_ENV="production"

# Port on which the Express server listens (default: 3000)
# Most cloud providers (Cloud Run, Render, Railway, Heroku) inject this automatically.
PORT=3000

# ------------------------------------------------------------------------------
# 2. PUBLIC FRONTEND CONFIGURATION (Safe for browser / Vite)
# ------------------------------------------------------------------------------
# Note: Any variable exposed to Vite/React client-side MUST begin with 'VITE_'.
# Currently, the frontend communicates with the backend via relative '/api/*'
# endpoints on the same origin, so NO public keys or client env vars are required.
#
# Optional custom API base URL (only if frontend and backend are hosted on separate domains):
# VITE_API_BASE_URL=""
